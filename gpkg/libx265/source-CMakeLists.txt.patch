--- a/source/CMakeLists.txt
+++ b/source/CMakeLists.txt
@@ -47,7 +47,7 @@
     string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" SYSPROC)
 endif()
 set(X86_ALIASES x86 i386 i686 x86_64 amd64)
-set(ARM_ALIASES armv6l armv7l)
+set(ARM_ALIASES armv6l armv7l armv7-a)
 set(ARM64_ALIASES arm64 arm64e aarch64)
 set(RISCV64_ALIASES riscv64)
 set(LOONGARCH64_ALIASES loongarch64)
@@ -323,13 +323,10 @@
         message(STATUS "cross compile arm")
 		set(ARM_ARGS -march=armv6 -mfloat-abi=soft -mfpu=vfp -marm -fPIC)
     elseif(ARM)
-        find_package(Neon)
-        if(CPU_HAS_NEON)
-            set(ARM_ARGS -mcpu=native -mfloat-abi=hard -mfpu=neon -marm -fPIC)
-            add_definitions(-DHAVE_NEON)
-        else()
-            set(ARM_ARGS -mcpu=native -mfloat-abi=hard -mfpu=vfp -marm)
-        endif()
+        # Never probe the build host CPU when cross compiling: -mcpu=native
+        # would be wrong here. Match the flags used to build the toolchain.
+        set(ARM_ARGS -march=armv7-a -mfpu=neon -mfloat-abi=hard -fPIC)
+        add_definitions(-DHAVE_NEON)
     endif()
     if(ARM64)
         set(CPU_HAS_NEON 1)
